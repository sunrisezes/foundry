PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus-lost-found
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Choose cloudinary, local, blob, or auto (Cloudinary when configured).
IMAGE_STORAGE_PROVIDER=auto
# Set CLOUDINARY_URL or all three CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET values.
CLOUDINARY_URL=
# Optional legacy fallback; Cloudinary is preferred when configured.
BLOB_READ_WRITE_TOKEN=
# Set to 1 to skip the initial model download and use the local visual descriptor.
VISION_OFFLINE=0
